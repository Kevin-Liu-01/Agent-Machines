# Daytona sandbox credentials. Keep keys server-side and out of source control.
DAYTONA_API_KEY=
DAYTONA_API_URL=https://app.daytona.io/api
# Optional placement target; defaults to us.
DAYTONA_TARGET=us

# Other sandbox adapters used by `pnpm mux` and owner dashboard defaults.
E2B_API_KEY=
SPRITES_TOKEN=
VERCEL_TOKEN=
VERCEL_TEAM_ID=
VERCEL_PROJECT_ID=

# Preferred LLM inference gateway. Vercel AI Gateway supports OpenAI-compatible
# /v1 calls, OIDC on Vercel, and static AI_GATEWAY_API_KEY for local/CI.
AI_GATEWAY_API_KEY=
VERCEL_OIDC_TOKEN=

# Fallback model router.
OPENROUTER_API_KEY=

# Explicit custom inference override, if you want LiteLLM, Portkey, RelayPlane,
# a self-hosted gateway, or another OpenAI-compatible router.
AGENT_CHAT_BASE_URL=
AGENT_CHAT_API_KEY=

# Default model. Use a provider/model slug routable by the selected gateway.
# Examples: anthropic/claude-sonnet-4-6, openai/gpt-5, google/gemini-2.5-pro, deepseek/deepseek-v3
# (legacy name HERMES_MODEL still works)
AGENT_MODEL=anthropic/claude-sonnet-4-6

# Machine sizing. Dev ceiling is 6144 MiB memory.
# (legacy names HERMES_VCPU / HERMES_MEMORY_MIB / HERMES_STORAGE_GIB still work)
AGENT_VCPU=1
AGENT_MEMORY_MIB=2048
AGENT_STORAGE_GIB=10

# The durable Daytona adapter disables automatic deletion and automatic stop.
# Stop/start is explicit; stopped files persist, processes and RAM do not.

# Cursor SDK API key (optional but required to use the cursor_agent MCP tool).
# Get one at https://cursor.com/dashboard/integrations or from Team Settings.
# When unset, the rest of the agent works fine; only delegating code work to a
# Cursor agent will fail with a clear error.
CURSOR_API_KEY=

# ----------------------------------------------------------------------------
# AI provider keys. Every agent accepts at least one of these.
#
# Hermes accepts ANY OpenAI-compatible endpoint: Vercel AI Gateway, OpenRouter,
# OpenAI, Anthropic, LiteLLM, Portkey, or self-hosted.
# Configure via hermes config set model.provider/model.base_url/model.api_key.
#
# OpenClaw mirrors keys to both ANTHROPIC_API_KEY and OPENAI_API_KEY so its
# built-in router picks whichever provider matches the chosen model.
#
# Claude Code requires ANTHROPIC_API_KEY (or a subscription via `claude auth login`).
# Codex CLI requires OPENAI_API_KEY (or a subscription via `codex` login flow).
# ----------------------------------------------------------------------------

# Anthropic API key -- used by Claude Code, OpenClaw, and Hermes (when
# pointed at Anthropic directly). Get one at https://console.anthropic.com
ANTHROPIC_API_KEY=

# OpenAI API key -- used by Codex CLI, OpenClaw, and Hermes (when
# pointed at OpenAI directly). Get one at https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Generic OpenAI-compatible gateway override.
AI_GATEWAY_URL=
AI_GATEWAY_KEY=

# ----------------------------------------------------------------------------
# web/ dashboard (Next.js control plane). NOT read by the deploy CLI.
# Authoritative env list: web/.env.local.example → copy to web/.env.local.
# Covers Clerk, Supabase (metrics/usage), CRON_SECRET (tick + crons),
# and owner fallbacks for all sandbox/native model providers. Ordinary hosted
# users set their own keys in Settings. Deployment keys are available only to
# the explicit owner below (or the opt-in local dev session).
# See web/docs/README.md and web/README.md.
# ----------------------------------------------------------------------------

# Clerk auth (https://dashboard.clerk.com -> API Keys). Gates /dashboard/*
# and /api/dashboard/*. Configure the allowlisted emails in the Clerk
# dashboard under "User & Authentication -> Restrictions".
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Exact Clerk user ID allowed to inherit deployment credentials and an optional
# pre-seeded machine. Leave blank to require BYOK for every hosted account.
AGENT_MACHINES_OWNER_USER_ID=

# Local dev auth bypass: set to 1 (with `pnpm web`) to run the dashboard
# without Clerk. Production/preview ignore it.
ALLOW_DEV_AUTH=0

# Supabase -- REQUIRED for durable machines, metrics, usage/cost, activity
# timeline, and benchmarks. Project URL + service-role key from Supabase.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Scheduler secret -- REQUIRED for crons + background usage/activity tracking
# (/api/internal/cron/tick). Vercel Cron calls the tick with this as a bearer.
# Generate: openssl rand -hex 32
CRON_SECRET=

# The machine the dashboard reports on. After `npm run deploy` finishes, the
# CLI prints `Machine ID: dm-...`; copy it here so the overview pulls real
# state without a re-deploy. Also stored in .machine-state.json.
# (legacy name HERMES_MACHINE_ID still works)
# AGENT_MACHINE_ID=

# Agent gateway (printed by `npm run deploy`). The chat + health proxies
# already consume these; the dashboard reuses them.
# (legacy names HERMES_API_URL / HERMES_API_KEY still work)
# AGENT_API_URL=
# AGENT_API_KEY=

# Legacy optional tunnel credential. Current runtimes use provider exec/PTY;
# Daytona signed preview URLs are short-lived and are not model gateways.
# CLOUDFLARE_TUNNEL_TOKEN=

# Chat history + artifacts persist under the Worker's provider home in
# .agent-machines/. Persistence and sleep/wake support depend on the provider.
