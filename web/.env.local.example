# Agent Machines dashboard. Copy to web/.env.local and fill only what you use.
# Next also reads root .env.local / .env as fallbacks. web/.env.local wins.
# Never put credentials in a NEXT_PUBLIC_ variable; those values reach browsers.

# Clerk authentication. Required on hosted deployments.
# Use production keys for the production domain and development keys locally.
# Leave blank for a local-only session with ALLOW_DEV_AUTH=1 below.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Production only: deploy /__clerk and verify its URL in Clerk first, then
# enable this in Vercel Production and redeploy. Leave unset locally/previews.
# NEXT_PUBLIC_CLERK_PROXY_URL=https://www.agent-machines.dev/__clerk

# Optional local development session. Works only with NODE_ENV=development.
# Uses web/.dev-user-config.json. Set to 0 to exercise real sign-up and sign-in.
# Local bypass is not evidence that hosted Clerk authentication works.
ALLOW_DEV_AUTH=1

# Hosted durable state, operation journal, metrics, usage, and scheduler data.
# Apply web/supabase/migrations in filename order to the same Supabase project.
# SUPABASE_SECRET_KEY is also accepted in place of SUPABASE_SERVICE_ROLE_KEY.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Required for hosted cron ticks. Generate with: openssl rand -hex 32
# Vercel invokes /api/internal/cron/tick every 5 minutes (web/vercel.json).
CRON_SECRET=

# Optional deployment-owner defaults. Ordinary accounts bring their own keys
# through Settings; deployment credentials must never fund new users silently.
# Set the exact Clerk user ID allowed to inherit the following env defaults.
# CLERK_OWNER_USER_ID is accepted as a legacy alias.
AGENT_MACHINES_OWNER_USER_ID=

# Sandbox credentials for the owner/local dev session. Configure at least one.
DAYTONA_API_KEY=
DAYTONA_API_URL=https://app.daytona.io/api
DAYTONA_TARGET=us
E2B_API_KEY=
SPRITES_TOKEN=
# Vercel Sandbox uses token + team + project, or injected Vercel OIDC credentials.
VERCEL_TOKEN=
VERCEL_TEAM_ID=
VERCEL_PROJECT_ID=
# VERCEL_OIDC_TOKEN=

# Model credentials for the owner/local dev session. User keys live in Settings.
# Claude Code uses Anthropic; Codex uses OpenAI. Hermes/OpenClaw also support
# compatible router routes where their configured runtime supports them.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
AI_GATEWAY_API_KEY=

# Optional owner integrations.
# CURSOR_API_KEY=
# CLOUDFLARE_TUNNEL_TOKEN=

# Optional existing owner Dedalus machine from the legacy deploy CLI.
# Leave unset for a new installation. Normal Workers are created in the app.
# AGENT_MACHINE_ID=
# AGENT_API_URL=
# AGENT_API_KEY=
# AGENT_MODEL=anthropic/claude-sonnet-4-6
# AGENT_VCPU=1
# AGENT_MEMORY_MIB=2048
# AGENT_STORAGE_GIB=10

# Hosted SDK callers normally create their own key in Settings → Developer API.
# The legacy deployment-wide API key requires an explicit owner user ID too:
# AGENT_MACHINES_API_KEY=
# AGENT_MACHINES_API_USER_ID=
